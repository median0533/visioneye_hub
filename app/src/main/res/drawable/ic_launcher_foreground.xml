<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient Vision Halo Glow -->
    <path
        android:pathData="M54,32 C36,32 23,49 20,54 C23,59 36,76 54,76 C72,76 85,59 88,54 C85,49 72,32 54,32 Z"
        android:strokeWidth="5"
        android:strokeAlpha="0.3">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="54"
                android:endX="88"
                android:endY="54"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#007AFF" android:offset="0.5" />
                <item android:color="#5856D6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek vISIONeYe Outer Contour -->
    <path
        android:pathData="M54,34 C37,34 25,50 22,54 C25,58 37,74 54,74 C71,74 83,58 86,54 C83,50 71,34 54,34 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="54"
                android:endX="86"
                android:endY="54"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#007AFF" android:offset="0.6" />
                <item android:color="#6E56CF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Aperture Vision Ring -->
    <path
        android:pathData="M54,41 A13,13 0 1,0 54,67 A13,13 0 1,0 54,41 Z"
        android:strokeWidth="2.2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="41"
                android:startY="41"
                android:endX="67"
                android:endY="67"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#5856D6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Iris Glowing Core -->
    <path
        android:pathData="M54,45 A9,9 0 1,0 54,63 A9,9 0 1,0 54,45 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="10"
                android:type="radial">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#007AFF" android:offset="0.7" />
                <item android:color="#1A2D69" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Dark Center Pupil -->
    <path
        android:pathData="M54,50 A4,4 0 1,0 54,58 A4,4 0 1,0 54,50 Z"
        android:fillColor="#080D1A" />

    <!-- Apple-style Specular Glass Gleam -->
    <path
        android:pathData="M52,51 A2,2 0 1,0 52,55 A2,2 0 1,0 52,51 Z"
        android:fillColor="#FFFFFF" />

    <!-- Lateral Precision Vision Ticks -->
    <path
        android:pathData="M14,54 L22,54"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M86,54 L94,54"
        android:strokeColor="#6E56CF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
</vector>
